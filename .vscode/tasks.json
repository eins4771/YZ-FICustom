{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mobile: dependencies",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Mobile: analyze",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze"],
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Web: development server",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "Web: build for ESP32",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build:esp32"],
      "options": { "cwd": "${workspaceFolder}/web" },
      "problemMatcher": []
    },
    {
      "label": "ESP32: build",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
      "args": ["run"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
